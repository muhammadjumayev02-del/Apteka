msgid "This password is entirely numeric."
msgstr "Bu parol faqat raqamlardan iborat."

msgid "Your password can’t be entirely numeric."
msgstr "Parol faqat raqamlardan iborat bo‘lmasligi kerak."

msgid "Password reset on %(site_name)s"
msgstr "%(site_name)s saytida parolni tiklash"

msgid "Enter a valid username. This value may contain only unaccented lowercase a-z and uppercase A-Z letters, numbers, and @/./+/-/_ characters."
msgstr "To‘g‘ri foydalanuvchi nomini kiriting. Faqat a-z, A-Z harflari, raqamlar va @/./+/-/_ belgilariga ruxsat beriladi."

msgid "Enter a valid username. This value may contain only letters, numbers, and @/./+/-/_ characters."
msgstr "To‘g‘ri foydalanuvchi nomini kiriting. Faqat harflar, raqamlar va @/./+/-/_ belgilariga ruxsat beriladi."

msgid "Logged out"
msgstr "Hisobdan chiqildi"

msgid "Password reset sent"
msgstr "Parolni tiklash xati yuborildi"

msgid "Enter new password"
msgstr "Yangi parolni kiriting"

msgid "Password reset unsuccessful"
msgstr "Parolni tiklab bo‘lmadi"

msgid "Password reset complete"
msgstr "Parol tiklandi"

msgid "Password change successful"
msgstr "Parol muvaffaqiyatli o‘zgartirildi"

msgid "Enter a valid domain name."
msgstr "To‘g‘ri domen nomini kiriting."

msgid "Enter a valid %(protocol)s address."
msgstr "To‘g‘ri %(protocol)s manzilini kiriting."

msgid "Ensure this value is a multiple of step size %(limit_value)s."
msgstr "Qiymat %(limit_value)s qadamiga karrali bo‘lsin."

msgid "Ensure this value is a multiple of step size %(limit_value)s, starting from %(offset)s, e.g. %(offset)s, %(valid_value1)s, %(valid_value2)s, and so on."
msgstr "Qiymat %(offset)s dan boshlanib %(limit_value)s qadamga mos bo‘lsin: %(offset)s, %(valid_value1)s, %(valid_value2)s va hokazo."

msgid "Constraint “%(name)s” is violated."
msgstr "“%(name)s” cheklovi buzildi."

msgid "String (unlimited)"
msgstr "Matn (cheklanmagan)"

msgid "%(model)s instance with %(field)s %(value)r is not a valid choice."
msgstr "%(model)s uchun %(field)s maydonidagi %(value)r to‘g‘ri tanlov emas."

msgid "This field is required."
msgstr "Bu maydonni to‘ldiring."

msgid "ManagementForm data is missing or has been tampered with. Missing fields: %(field_names)s. You may need to file a bug report if the issue persists."
msgstr "Forma boshqaruv ma’lumotlari yo‘q yoki o‘zgartirilgan. Yetishmayotgan maydonlar: %(field_names)s. Xato takrorlansa, administratorga xabar bering."

msgid "Please submit at most %(num)d form."
msgid_plural "Please submit at most %(num)d forms."
msgstr[0] "Ko‘pi bilan %(num)d ta forma kiriting."

msgid "Please submit at least %(num)d form."
msgid_plural "Please submit at least %(num)d forms."
msgstr[0] "Kamida %(num)d ta forma kiriting."

