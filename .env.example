# Faqat lokal HTTP uchun. Yuklash: bash scripts/run_local.sh
DJANGO_DEBUG=1
# Bo‘sh qoldirmang: DEPLOYMENT.md dagi buyruq bilan shaxsiy .env da yarating.
# Haqiqiy kalitni bu namuna fayliga yoki Gitga yozmang.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TRUST_PROXY=0
